{
  "version": "1.0.0",
  "layout_name": "_user_base",
  "meta": { "title": "$t:base.title", "is_base": true },
  "data_sources": [{ "id": "current_user", "label_key": "$t:auth.current_user_data_source", "type": "api", "endpoint": "/api/auth/user", "method": "GET", "auto_fetch": true, "auth_required": true, "loading_strategy": "progressive", "initGlobal": "currentUser", "fallback": { "data": null } }],
  "slots": { "content": [] },
  "components": [
    { "type": "basic", "name": "Div", "props": { "className": "glitter-directory-root" }, "children": [
      { "type": "composite", "name": "DirectoryHeader", "if": "{{!_global.currentUser?.uuid}}", "props": { "brandName": "$t:brand.name", "browseLabel": "$t:nav.browse", "loginLabel": "$t:auth.login", "registerLabel": "$t:auth.register", "themeLabel": "$t:theme.label", "systemLabel": "$t:theme.system", "lightLabel": "$t:theme.light", "darkLabel": "$t:theme.dark", "themeSystemText": "$t:theme.current_system", "themeLightText": "$t:theme.current_light", "themeDarkText": "$t:theme.current_dark", "navigationLabel": "$t:base.navigation_label" } },
      { "type": "composite", "name": "DirectoryHeader", "if": "{{_global.currentUser?.uuid}}", "actions": [{ "event": "onLogout", "handler": "logout", "target": "user", "onSuccess": [{ "handler": "navigate", "params": { "path": "/directory" } }] }], "props": { "brandName": "$t:brand.name", "browseLabel": "$t:nav.browse", "authenticated": true, "nickname": "{{raw:_global.currentUser?.nickname}}", "name": "{{raw:_global.currentUser?.name}}", "avatar": "{{_global.currentUser?.avatar}}", "isAdmin": "{{_global.currentUser?.is_admin}}", "accountLabel": "$t:auth.account", "logoutLabel": "$t:auth.logout", "adminLabel": "$t:auth.admin", "languageLabel": "$t:auth.language", "languageOptionsLabel": { "ko": "$t:auth.language_ko", "en": "$t:auth.language_en" }, "themeLabel": "$t:theme.label", "systemLabel": "$t:theme.system", "lightLabel": "$t:theme.light", "darkLabel": "$t:theme.dark", "themeSystemText": "$t:theme.current_system", "themeLightText": "$t:theme.current_light", "themeDarkText": "$t:theme.current_dark", "navigationLabel": "$t:base.navigation_label" } },
      { "type": "basic", "name": "Main", "props": { "className": "gd-main" }, "children": [{ "type": "basic", "name": "Div", "slot": "content", "children": [] }] },
      { "type": "basic", "name": "Footer", "props": { "className": "gd-footer" }, "children": [{ "type": "basic", "name": "Div", "props": { "className": "gd-container gd-footer-inner" }, "children": [{ "type": "basic", "name": "Span", "text": "$t:footer.copyright" }, { "type": "basic", "name": "A", "props": { "href": "/directory" }, "text": "$t:nav.home" }] }] }
    ] }
  ]
}
