{
  "version": "1.0.0",
  "layout_name": "directory/index",
  "extends": "_user_base",
  "meta": { "title": "$t:directory.page_title", "description": "$t:directory.description" },
  "data_sources": [
    { "id": "directory", "label_key": "$t:directory.data_source", "type": "api", "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}", "method": "GET", "auto_fetch": true, "auth_mode": "optional", "loading_strategy": "blocking", "refetchOnMount": true },
    { "id": "listings", "label_key": "$t:directory.listings_data_source", "type": "api", "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts", "method": "GET", "params": { "page": "{{query?.page ?? 1}}", "per_page": "{{query?.per_page ?? 20}}", "search": "{{query?.q ?? ''}}", "category": "{{query?.category ?? ''}}", "sort_by": "{{query?.sort === 'newest' || query?.sort === 'oldest' ? 'created_at' : query?.sort === 'most_viewed' ? 'view_count' : ''}}", "sort_order": "{{query?.sort === 'oldest' ? 'asc' : query?.sort === 'newest' || query?.sort === 'most_viewed' ? 'desc' : ''}}" }, "auto_fetch": true, "auth_mode": "optional", "loading_strategy": "progressive", "refetchOnMount": true, "onSuccess": [{ "handler": "setState", "params": { "target": "local", "listingPostIds": "{{response.data.data.map(post => post.id)}}" } }, { "handler": "refetchDataSource", "params": { "dataSourceId": "listingTranslations" } }] },
    { "id": "listingTranslations", "label_key": "$t:directory.translations_data_source", "type": "api", "endpoint": "/api/plugins/glitter-translate/posts/translations/batch", "method": "POST", "params": { "board": "{{route.slug}}", "post_ids": "{{_local.listingPostIds ?? []}}", "fields": ["title"] }, "auto_fetch": false, "if": "{{_global.installedPlugins?.find(p => p.identifier === 'glitter-translate' && p.status === 'active')}}", "auth_mode": "optional", "loading_strategy": "progressive", "fallback": null }
  ],
  "slots": { "content": [{ "type": "basic", "name": "Section", "props": { "className": "gd-container gd-shell" }, "children": [
    { "type": "basic", "name": "A", "props": { "href": "/directory", "className": "gd-back-link" }, "text": "$t:directory.browse_directories" },
    { "type": "basic", "name": "Div", "if": "{{directory?.loading}}", "props": { "className": "gd-state", "role": "status", "aria-live": "polite" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.loading" }] },
    { "type": "basic", "name": "Div", "if": "{{directory?.error}}", "props": { "className": "gd-state gd-error", "role": "alert" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.error" }, { "type": "basic", "name": "A", "props": { "href": "/directory", "className": "gd-link-button" }, "text": "$t:directory.back_home" }] },
    { "type": "basic", "name": "Div", "if": "{{directory?.data && !directory?.error}}", "children": [
      { "type": "basic", "name": "P", "props": { "className": "gd-eyebrow" }, "text": "$t:directory.kicker" }, { "type": "basic", "name": "H1", "props": { "className": "gd-page-title" }, "text": "{{raw:directory.data.name}}" }, { "type": "basic", "name": "P", "if": "{{directory.data.description}}", "props": { "className": "gd-lede" }, "text": "{{raw:directory.data.description}}" },
      { "type": "basic", "name": "Section", "if": "{{directory.data.categories?.length > 0}}", "props": { "className": "gd-category-panel", "aria-labelledby": "gd-category-title" }, "children": [{ "type": "basic", "name": "H2", "props": { "id": "gd-category-title", "className": "gd-section-title" }, "text": "$t:category.title" }, { "type": "basic", "name": "Nav", "props": { "aria-label": "$t:category.navigation_label" }, "children": [{ "type": "basic", "name": "Ul", "props": { "className": "gd-category-list" }, "children": [{ "type": "basic", "name": "Li", "children": [{ "type": "basic", "name": "A", "props": { "href": "/directory/{{route.slug}}?page=1{{query?.q ? '&q=' + query.q : ''}}{{query?.view ? '&view=' + query.view : ''}}{{query?.sort ? '&sort=' + query.sort : ''}}", "className": "gd-category-link", "aria-current": "{{!query?.category ? 'page' : undefined}}" }, "text": "$t:category.all" }] }, { "type": "basic", "name": "Li", "iteration": { "source": "{{directory.data.categories ?? []}}", "item_var": "category" }, "if": "{{category !== 'unclassified}}", "children": [{ "type": "basic", "name": "A", "props": { "href": "/directory/{{route.slug}}?category={{category}}{{query?.q ? '&q=' + query.q : ''}}&page=1{{query?.view ? '&view=' + query.view : ''}}{{query?.sort ? '&sort=' + query.sort : ''}}", "className": "gd-category-link", "aria-current": "{{query?.category === category ? 'page' : undefined}}" }, "text": "{{raw:category}}" }] }] }] }] },
      { "type": "basic", "name": "Section", "props": { "className": "gd-search-panel", "aria-labelledby": "gd-search-title" }, "children": [{ "type": "basic", "name": "H2", "props": { "id": "gd-search-title", "className": "gd-section-title" }, "text": "$t:search.title" }, { "type": "basic", "name": "Form", "dataKey": "directorySearch", "props": { "className": "gd-search-form", "role": "search" }, "actions": [{ "type": "submit", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": false, "query": { "q": "{{$event.target.q.value}}", "category": "{{query?.category ?? ''}}", "page": 1, "view": "{{query?.view ?? ''}}", "sort": "{{query?.sort ?? ''}}" } } }], "children": [{ "type": "basic", "name": "Label", "props": { "htmlFor": "gd-search-query", "className": "gd-visually-hidden" }, "text": "$t:search.label" }, { "type": "basic", "name": "Input", "props": { "id": "gd-search-query", "name": "q", "type": "search", "value": "{{query?.q ?? ''}}", "className": "gd-search-input", "placeholder": "$t:search.placeholder" } }, { "type": "basic", "name": "Button", "props": { "type": "submit", "className": "gd-button" }, "text": "$t:search.submit" }] }, { "type": "basic", "name": "A", "if": "{{query?.q}}", "props": { "href": "/directory/{{route.slug}}?page=1{{query?.category ? '&category=' + query.category : ''}}{{query?.view ? '&view=' + query.view : ''}}{{query?.sort ? '&sort=' + query.sort : ''}}", "className": "gd-clear-link" }, "text": "$t:search.clear" }]},
      { "type": "basic", "name": "Section", "props": { "className": "gd-explorer-toolbar", "aria-labelledby": "gd-explorer-title" }, "children": [{ "type": "basic", "name": "H2", "props": { "id": "gd-explorer-title", "className": "gd-section-title" }, "text": "$t:directory.explorer_label" }, { "type": "basic", "name": "P", "props": { "className": "gd-explorer-state" }, "if": "{{query?.q || query?.category}}", "text": "$t:directory.explorer_active_filters" }, { "type": "basic", "name": "P", "props": { "className": "gd-sort-label" }, "text": "$t:directory.sort_label" }, { "type": "basic", "name": "Div", "props": { "className": "gd-sort-controls", "role": "group", "aria-label": "$t:directory.sort_label" }, "children": [{ "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-sort-button {{!query?.sort || query?.sort === 'default' || (query?.sort !== 'newest' && query?.sort !== 'oldest' && query?.sort !== 'most_viewed') ? 'is-current' : ''}}", "aria-pressed": "{{!query?.sort || query?.sort === 'default' || (query?.sort !== 'newest' && query?.sort !== 'oldest' && query?.sort !== 'most_viewed')}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "sort": "default", "page": 1 } } }], "text": "$t:directory.sort_default" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-sort-button {{query?.sort === 'newest' ? 'is-current' : ''}}", "aria-pressed": "{{query?.sort === 'newest'}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "sort": "newest", "page": 1 } } }], "text": "$t:directory.sort_newest" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-sort-button {{query?.sort === 'oldest' ? 'is-current' : ''}}", "aria-pressed": "{{query?.sort === 'oldest'}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "sort": "oldest", "page": 1 } } }], "text": "$t:directory.sort_oldest" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-sort-button {{query?.sort === 'most_viewed' ? 'is-current' : ''}}", "aria-pressed": "{{query?.sort === 'most_viewed'}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "sort": "most_viewed", "page": 1 } } }], "text": "$t:directory.sort_most_viewed" }] }, { "type": "basic", "name": "A", "if": "{{query?.category || query?.q || query?.sort === 'newest' || query?.sort === 'oldest' || query?.sort === 'most_viewed}}", "props": { "href": "/directory/{{route.slug}}?page=1{{query?.view ? '&view=' + query.view : ''}}{{query?.per_page ? '&per_page=' + query.per_page : ''}}", "className": "gd-reset-link" }, "text": "$t:directory.reset_filters" }]},
      { "type": "basic", "name": "Div", "props": { "className": "gd-explorer-view-toggle", "role": "group", "aria-label": "$t:directory.view_label" }, "children": [{ "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-view-toggle-button {{query?.view === 'list' ? '' : 'is-current'}}", "aria-pressed": "{{query?.view !== 'list'}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "view": "grid" } } }], "text": "$t:directory.view_grid" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "gd-view-toggle-button {{query?.view === 'list' ? 'is-current' : ''}}", "aria-pressed": "{{query?.view === 'list'}}" }, "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/directory/{{route.slug}}", "mergeQuery": true, "query": { "view": "list" } } }], "text": "$t:directory.view_list" }] },
      { "type": "basic", "name": "P", "if": "{{query?.q && query?.category}}", "props": { "className": "gd-explorer-state" }, "text": "$t:search.context_with_category|query={{raw:query.q}}|category={{raw:query.category}}" },
      { "type": "basic", "name": "P", "if": "{{query?.q && !query?.category}}", "props": { "className": "gd-explorer-state" }, "text": "$t:search.context|query={{raw:query.q}}" },
      { "type": "basic", "name": "P", "if": "{{!query?.q && query?.category}}", "props": { "className": "gd-explorer-state" }, "text": "$t:category.context|category={{raw:query.category}}" },
      { "type": "basic", "name": "P", "if": "{{!listings?.loading && !listings?.error && listings?.data?.pagination && listings.data.pagination.total_is_exact}}", "props": { "className": "gd-results-summary", "role": "status", "aria-live": "polite" }, "text": "$t:results.summary|count={{listings.data.pagination.count}}|total={{listings.data.pagination.total}}" },
      { "type": "basic", "name": "P", "if": "{{!listings?.loading && !listings?.error && listings?.data?.pagination && !listings.data.pagination.total_is_exact}}", "props": { "className": "gd-results-summary", "role": "status", "aria-live": "polite" }, "text": "$t:results.summary_capped|count={{listings.data.pagination.count}}" },
      { "type": "basic", "name": "Div", "if": "{{listings?.loading}}", "props": { "className": "gd-state", "role": "status", "aria-live": "polite" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.loading" }] },
      { "type": "basic", "name": "Div", "if": "{{listings?.error}}", "props": { "className": "gd-state gd-error", "role": "alert" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.error" }] },
      { "type": "basic", "name": "Div", "if": "{{!listings?.loading && !listings?.error && (listings?.data?.data?.length ?? 0) > 0}}", "props": { "className": "gd-listing-grid {{query?.view === 'list' ? 'gd-listing-grid--list' : 'gd-listing-grid--grid'}}", "role": "list", "aria-label": "$t:directory.listings_label" }, "children": [{ "type": "composite", "name": "ListingCard", "iteration": { "source": "{{listings.data.data ?? []}}", "item_var": "listing" }, "props": { "href": "/directory/{{route.slug}}/listings/{{listing.id}}{{query?.category || query?.q || query?.page || query?.view || query?.sort ? '?' + (query?.category ? 'category=' + query.category + ((query?.q || query?.page || query?.view || query?.sort) ? '&' : '') : '') + (query?.q ? 'q=' + query.q + ((query?.page || query?.view || query?.sort) ? '&' : '') : '') + (query?.page ? 'page=' + query.page + ((query?.view || query?.sort) ? '&' : '') : '') + (query?.view ? 'view=' + query.view + (query?.sort ? '&' : '') : '') + (query?.sort ? 'sort=' + query.sort : '') : ''}}", "title": "{{raw:listingTranslations?.data?.[listing.id]?.fields?.title?.value ?? listing.title}}", "category": "{{raw:listing.category}}", "preview": "{{raw:listing.content_preview}}", "date": "{{listing.created_at_formatted ?? listing.created_at}}", "thumbnail": "{{listing.thumbnail}}", "authorName": "{{raw:listing.author?.name}}", "isNew": "{{listing.is_new === true}}", "newLabel": "$t:listing.new", "viewCount": "{{listing.view_count}}", "showViewCount": "{{listings.data.board?.settings?.show_view_count !== false}}", "viewCountText": "$t:listing.views|count={{listing.view_count}}", "categoryText": "$t:listing.category_with_name|category={{raw:listing.category}}", "variant": "{{query?.view === 'list' ? 'list' : 'grid'}}" } }] },
      { "type": "basic", "name": "Div", "if": "{{!listings?.loading && !listings?.error && (listings?.data?.data?.length ?? 0) === 0}}", "props": { "className": "gd-empty-card" }, "children": [{ "type": "basic", "name": "H2", "if": "{{query?.q || query?.category}}", "props": { "className": "gd-empty-title" }, "text": "$t:directory.filtered_empty_title" }, { "type": "basic", "name": "A", "if": "{{query?.q || query?.category || query?.sort === 'newest' || query?.sort === 'oldest' || query?.sort === 'most_viewed}}", "props": { "href": "/directory/{{route.slug}}?page=1{{query?.view ? '&view=' + query.view : ''}}{{query?.per_page ? '&per_page=' + query.per_page : ''}}", "className": "gd-reset-link" }, "text": "$t:directory.reset_filters" }, { "type": "basic", "name": "H2", "if": "{{!query?.q && !query?.category}}", "props": { "className": "gd-empty-title" }, "text": "$t:directory.empty_title" }] },
      { "type": "composite", "name": "DirectoryPagination", "if": "{{listings?.data?.pagination && (listings.data.pagination.current_page > 1 || listings.data.pagination.has_more_pages === true || (listings.data.pagination.total_is_exact === true && listings.data.pagination.last_page > 1))}}", "props": { "basePath": "/directory/{{route.slug}}", "currentPage": "{{listings.data.pagination.current_page ?? 1}}", "lastPage": "{{listings.data.pagination.last_page ?? null}}", "totalIsExact": "{{listings.data.pagination.total_is_exact === true}}", "hasMorePages": "{{listings.data.pagination.has_more_pages === true}}", "category": "{{query?.category ?? ''}}", "search": "{{query?.q ?? ''}}", "view": "{{query?.view ?? ''}}", "sort": "{{query?.sort ?? ''}}", "perPage": "{{query?.per_page ?? ''}}", "paginationLabel": "$t:pagination.label", "previousLabel": "$t:pagination.previous_short", "nextLabel": "$t:pagination.next_short", "previousAriaLabel": "$t:pagination.previous", "nextAriaLabel": "$t:pagination.next" } }
    ] }
  ] }] }
}
